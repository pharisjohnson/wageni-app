# Copy to .env.local for local development. Never commit real values.
# `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL for you.

# --- Required for signed-in features -------------------------------------
# Convex (https://dashboard.convex.dev)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set in the *Convex dashboard* (Settings → Environment Variables), not here:
#   CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# Optional, Convex dashboard, development deployments only:
#   ALLOW_DEMO_SEED=true

# --- F2: invitation links, per-IP limits, uploads --------------------------
# Next.js side (this file / Vercel project env):
#   INVITE_PROXY_SECRET   Shared secret (at least 32 random characters, e.g. `openssl rand -base64 36`).
#                         The Next.js route handlers under /app/api/invite/* send it to Convex, which refuses
#                         every public invitation call without it. MUST be set to the SAME value in the Convex
#                         dashboard (Settings -> Environment Variables). Unset = invitation links do not work
#                         (fails closed), except in development with ALLOW_UNPROXIED_INVITES=true.
INVITE_PROXY_SECRET=
#   CLIENT_IP_HEADER      Optional. Name of a request header your proxy sets to the client address, when you
#                         do not host on Vercel (default: x-real-ip, then x-forwarded-for).
CLIENT_IP_HEADER=
#   ALLOW_UNPROXIED_INVITES  Development ONLY. "true" lets the invite page work without a secret (all callers share
#                         one rate limit). Must also be set in the Convex dashboard. Never set it in production.
ALLOW_UNPROXIED_INVITES=
#
# Convex dashboard side (Settings -> Environment Variables), NOT in this file:
#   INVITE_PROXY_SECRET      Same value as above.
#   APP_BASE_URL             Public URL of the app, e.g. https://app.example.com . Used for absolute invitation links
#                            (email/SMS). Wins over the origin sent by the browser. Recommended in production:
#                            without it any signed-in member could point their own invitations at another host.
#   ALLOW_LOCAL_ORIGIN       Development only. "true" accepts http://localhost origins for invitation links.
#   ALLOW_UNPROXIED_INVITES  Development only, see above.

# --- H1: hardening and operations (Next.js side: Vercel project env) ---------
#   HEALTH_CHECK_TOKEN  At least 16 random characters. Enables `GET /api/health?deep=1` (needs
#                       `Authorization: Bearer <token>`), which also pings Convex. Unset = deep checks refused.
HEALTH_CHECK_TOKEN=
#   CSP_REPORT_ONLY     "true" sends the Content-Security-Policy as report-only (use for a first preview rollout).
CSP_REPORT_ONLY=
#   CSP_REPORT_URI      Optional https endpoint that receives CSP violation reports.
CSP_REPORT_URI=
# --- end H1

# --- Optional -------------------------------------------------------------
# Product name shown in the UI (default: Wageni)
NEXT_PUBLIC_APP_NAME=
# Public base URL (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk routing (recommended)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- N1: notifications (Convex dashboard -> Settings -> Environment Variables) ---
# Everything below is OPTIONAL. With none of it set, every channel runs in
# "dry-run" mode: messages are recorded in the outbox (Messages page) but never
# sent. Secrets live only in the Convex environment; they are never logged,
# stored in tables or shown in the UI.
#
# Email (Resend-style HTTP API)
#   NOTIFY_EMAIL_PROVIDER=resend
#   RESEND_API_KEY=
#   NOTIFY_EMAIL_FROM=no-reply@your-domain.example
# SMS (Africa's Talking)
#   NOTIFY_SMS_PROVIDER=africastalking
#   AT_USERNAME=
#   AT_API_KEY=
#   AT_SENDER_ID=            (optional)
#   AT_SANDBOX=true          (optional, use the sandbox host)
# WhatsApp (Cloud API; business-initiated messages need approved templates named wageni_<event>)
#   NOTIFY_WHATSAPP_PROVIDER=cloudapi
#   WHATSAPP_PHONE_NUMBER_ID=
#   WHATSAPP_ACCESS_TOKEN=
# Turn local numbers (0700...) into international ones, e.g. 254 for Kenya
#   NOTIFY_DEFAULT_COUNTRY_CODE=254
# Delivery-receipt webhook: POST <convex site url>/webhooks/notifications signed with this secret
# (x-wageni-timestamp + x-wageni-signature = hex HMAC-SHA256 of "<timestamp>.<body>"). Unset = endpoint off.
#   NOTIFY_WEBHOOK_SECRET=
# --- end N1

# --- B1/B2: plans and PayHero M-Pesa billing (Convex dashboard -> Settings -> Environment Variables) ---
# See docs/billing.md. None of this is needed for development (payments run in dry-run mode).
#   BILLING_ENFORCEMENT=on     Turn plan limits on. Anything other than "on" (default) unlocks every feature for
#                              every organization.
#   PAYHERO_MODE=live          Send real M-Pesa STK pushes. Unset (default) = dry-run, nothing is sent.
#   PAYHERO_AUTH_TOKEN=        Basic authorization token from PayHero dashboard -> API Keys (with or without "Basic ").
#   PAYHERO_CHANNEL_ID=        Numeric id of your registered M-Pesa payment channel.
#   PAYHERO_CALLBACK_BASE=     Your Convex HTTP URL, https://<deployment>.convex.site (callbacks go to
#                              <base>/webhooks/payhero/<per-payment-token>).
#   BILLING_HASH_PEPPER=       Optional secret for hashing phone numbers (defaults to PAYHERO_AUTH_TOKEN).
#   ALLOW_BILLING_SIMULATION=true   Development ONLY: shows "Simulate" buttons for dry-run payments.
# Prices and trial length: lib/billing/pricing.ts (not an env var).
# --- end B1/B2
